# How the phone talks to the display.
#   ws        - local relay (server/relay.ts). Default. Real phones on the same Wi-Fi.
#   broadcast - same-browser BroadcastChannel. Open the phone view in a second window. No relay needed.
NEXT_PUBLIC_TRANSPORT=ws

# Relay address. Defaults to ws://<host the page was loaded from>:3001
# NEXT_PUBLIC_RELAY_URL=ws://192.168.1.20:3001

# Base URL encoded in the QR code. Defaults to the laptop's LAN IP when the display
# is opened on localhost, otherwise the page origin. Set this once deployed.
# NEXT_PUBLIC_PUBLIC_URL=https://monitoring-challenge.vercel.app

# Relay port (server/relay.ts)
# RELAY_PORT=3001
